# =============================================================================
# .gitignore -- Student Performance Analytics
# =============================================================================

# -- Secrets & environment variables ------------------------------------------
.env
.env.*
*.env
secrets.toml
.streamlit/secrets.toml

# -- Python runtime ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# -- Virtual environments ------------------------------------------------------
venv/
.venv/
env/
ENV/
.virtualenv/

# -- Jupyter Notebook checkpoints ----------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# -- IDE / editor --------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# -- OS artefacts --------------------------------------------------------------
Desktop.ini
*.swp
*.swo

# -- Build / distribution ------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
.eggs/

# -- Test / coverage -----------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/

# -- Bob assistant temp files --------------------------------------------------
.bob/

# NOTE: models/*.pkl, figures/*.png, dataset.csv, and the notebook are all
# intentionally tracked -- they are required for the app to run.
